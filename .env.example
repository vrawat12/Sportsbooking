# Copy this file to .env and fill in your credentials
# cp .env.example .env

# Your Kotofit / CourtReserve account credentials
KOTOFIT_EMAIL=your_email@example.com
KOTOFIT_PASSWORD=your_password_here

# CourtReserve organization URL for Kotofit Jersey City - Brunswick St
# Find this by clicking "Book" on kotofit.com and copying the URL
COURTRESERVE_ORG_URL=https://app.courtreserve.com/Online/Reservations/Bookings/8848?sId=21387

# Telegram bot credentials
# 1. Message @BotFather on Telegram → /newbot → copy the token it gives you
# 2. Message @userinfobot on Telegram → it replies with your numeric chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxYZ
TELEGRAM_CHAT_ID=987654321

# How many days ahead to look for slots (max 14 for free members, 21 for paid)
DAYS_AHEAD=7

# Check interval in seconds (1800 = 30 minutes)
CHECK_INTERVAL_SECONDS=1800

# Sport type (badminton, pickleball, pingpong)
SPORT_TYPE=badminton

# Set to true to run without a visible browser window
HEADLESS=false
